---
/**
 * Static, crawlable festival list grouped by month: every entry is a real link
 * to the festival's own page. Used by the hub pages.
 */
import type { Festival } from "@/types/festival";
import { groupByMonth } from "@/lib/filters";
import { formatDateRange } from "@/lib/dates";
import { festivalPath } from "@/lib/seo";
import { getCountryFlag, getGenreColorHex } from "@/lib/utils";

interface Props {
  festivals: Festival[];
}

const months = groupByMonth(Astro.props.festivals);
---

<div class="space-y-10">
  {months.map((month) => (
    <section>
      <h2 class="mb-4 text-3xl text-white">{month.label} <span class="font-sans text-base font-medium normal-case text-muted-foreground">· {month.festivals.length}</span></h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {month.festivals.map((f) => (
          <li>
            <a href={festivalPath(f.id)} class="flex h-full flex-col gap-2 rounded-2xl border border-border bg-card p-4 transition-colors hover:border-input">
              <span class="text-lg font-semibold text-white">{f.name}</span>
              <span class="text-sm text-muted-foreground">{formatDateRange(f.start_date, f.end_date)} · {getCountryFlag(f.country_code)} {f.city}, {f.country_name}</span>
              <span class="flex flex-wrap gap-1.5">
                {f.genres.map((g) => (
                  <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold text-ink" style={`background:${getGenreColorHex(g)}`}>{g}</span>
                ))}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
