---
import { GlobalGenreFilter } from "@/components/GlobalGenreFilter";
import { dataUpdatedAt, festivals, yearRangeLabel } from "@/lib/festival-data";
import { formatUpdatedAt } from "@/lib/dates";
import { SITE_URL, jsonLd as toJsonLd } from "@/lib/seo";
import { footerHubs } from "@/lib/hubs";
// Self-hosted: no request to Google from the visitor's browser.
import "@fontsource/anton";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";

interface Props {
  title: string;
  description?: string;
  /** Structured data objects, one `<script type="application/ld+json">` each. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** A JSON file an island will fetch: start the download with the HTML. */
  preload?: string;
}

const {
  title,
  description = "Every music festival in Europe on one map and calendar: dates, lineups, tickets, filtered by the sin you came for.",
  jsonLd = [],
  noindex = false,
  preload,
} = Astro.props;

const canonical = `${SITE_URL}${Astro.url.pathname}`;
const ogImage = `${SITE_URL}/og.png`;

const updatedLabel = formatUpdatedAt(dataUpdatedAt);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonical} />
    {preload && <link rel="preload" href={preload} as="fetch" crossorigin="anonymous" />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Synners" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={toJsonLd(data)} />)}

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <header class="sticky top-0 z-50 border-b border-border/50 bg-background/80 backdrop-blur-xl">
      <nav class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="logo-link group flex items-baseline gap-3">
            <span class="font-display text-3xl text-foreground transition-colors group-hover:text-white">Synners<span class="text-primary">.</span></span>
            <span class="hidden sm:inline text-xs font-semibold uppercase tracking-widest text-muted-foreground">{yearRangeLabel} Festivals</span>
          </a>

          <div class="hidden md:flex items-center gap-1">
            <a href="/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Home
            </a>
            <a href="/map/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Map
            </a>
            <a href="/calendar/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Calendar
            </a>
            <a href="/list/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              List
            </a>
            <a href="/artists/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Artists
            </a>
            <a href="/planner/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Planner
            </a>
          </div>

          <!-- Mobile Menu -->
          <div class="md:hidden">
            <button id="mobile-menu-btn" type="button" aria-label="Menu" aria-controls="mobile-menu" aria-expanded="false" class="flex h-11 w-11 items-center justify-center rounded-full border border-input bg-field hover:bg-muted transition-colors">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Global Genre Filter (Desktop) -->
        <div class="hidden md:flex items-center justify-center pt-3 mt-3 border-t border-border/50">
          <GlobalGenreFilter client:load />
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="hidden md:hidden mt-4 pb-2 border-t border-border pt-4">
          <div class="flex flex-col gap-2">
            <a href="/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Home
            </a>
            <a href="/map/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Map
            </a>
            <a href="/calendar/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Calendar
            </a>
            <a href="/list/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              List
            </a>
            <a href="/artists/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Artists
            </a>
            <a href="/planner/" class="px-4 py-2.5 rounded-full text-sm font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
              Planner
            </a>
          </div>
          <!-- Global Genre Filter (Mobile) -->
          <div class="flex items-center pt-3 mt-3 border-t border-border/50">
            <GlobalGenreFilter client:load />
          </div>
        </div>
      </nav>
    </header>

    <main class="container mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-border mt-16">
      <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <span class="font-display text-2xl text-foreground">Synners<span class="text-primary">.</span></span>
          <p class="text-sm text-muted-foreground">
            Find your place to sin
          </p>
          <p class="text-sm text-muted-foreground">
            For sinners, by sinners
          </p>
        </div>
        <nav aria-label="Browse festivals" class="mt-8 grid gap-6 text-sm sm:grid-cols-2">
          <div>
            <h2 class="mb-2 font-sans text-xs font-semibold uppercase tracking-widest text-muted-foreground">By country</h2>
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
              {footerHubs.countries.map((hub) => <li><a href={hub.path} class="text-foreground/80 hover:text-white">{hub.country}</a></li>)}
              <li><a href="/countries/" class="text-secondary hover:text-white">All countries</a></li>
            </ul>
          </div>
          <div>
            <h2 class="mb-2 font-sans text-xs font-semibold uppercase tracking-widest text-muted-foreground">By genre</h2>
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
              {footerHubs.genres.map((hub) => <li><a href={hub.path} class="text-foreground/80 hover:text-white">{hub.genre}</a></li>)}
              <li><a href="/festivals/" class="text-secondary hover:text-white">Festivals A-Z</a></li>
            </ul>
          </div>
        </nav>
        <p class="mt-6 text-center text-xs text-muted-foreground/70">
          {festivals.length} festival{festivals.length === 1 ? "" : "s"} · {yearRangeLabel}{updatedLabel ? ` · Data updated ${updatedLabel}` : ""}
        </p>
      </div>
    </footer>

    <script>
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileMenuBtn?.addEventListener('click', () => {
        const open = !mobileMenu?.classList.toggle('hidden');
        mobileMenuBtn.setAttribute('aria-expanded', String(open));
      });

      // Highlight active nav link (exclude logo link)
      const currentPath = window.location.pathname;
      document.querySelectorAll('nav a[href]:not(.logo-link)').forEach(link => {
        if (link.getAttribute('href') === currentPath) {
          link.classList.remove('text-muted-foreground');
          link.classList.add('text-foreground', 'bg-muted');
          link.setAttribute('aria-current', 'page');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/globals.css";
</style>
