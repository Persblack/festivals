---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found | Synners" noindex>
  <div class="space-y-6 py-16">
    <h1 class="text-6xl md:text-8xl text-white">Lost your <span class="text-primary">way.</span></h1>
    <p class="max-w-xl text-lg text-muted-foreground">This page does not exist, or the festival moved on. The rest of the sinners are still here.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/festivals/" class="rounded-xl bg-primary px-6 py-3 font-bold uppercase tracking-wider text-white hover:bg-[#B3122A]">Festivals A-Z</a>
      <a href="/" class="rounded-xl border border-input bg-field px-6 py-3 font-bold uppercase tracking-wider text-white hover:bg-muted">Home</a>
    </div>
  </div>
</Layout>
