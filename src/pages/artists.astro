---
import Layout from "../layouts/Layout.astro";
import { ArtistsPage } from "../components/ArtistsPage";
import { festivals } from "@/lib/festival-data";
---

<Layout title="Festival Lineups: Find Where Your Artist Plays | Synners" description="Search festival lineups across Europe by artist and see every festival they play this season.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">Artists</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Discover which festivals your favorite artists are playing at.
      </p>
    </div>

    <ArtistsPage client:idle festivals={festivals} />
  </div>
</Layout>
