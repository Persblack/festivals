---
import Layout from "../layouts/Layout.astro";
import { ArtistsPage } from "../components/ArtistsPage";
import festivalsData from "../data/festivals.json";

const festivals = festivalsData.festivals;
---

<Layout title="Artists - Festival Atlas" description="Browse artists performing at Central European music festivals. Search by name and see which festivals they play.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">Artists</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Discover which festivals your favorite artists are playing at.
      </p>
    </div>

    <ArtistsPage client:load festivals={festivals} />
  </div>
</Layout>
