---
import Layout from "../layouts/Layout.astro";
import { ArtistsPageIsland } from "../components/ArtistsPage";
import { festivalDataUrl } from "@/lib/festival-data-file";
---

<Layout preload={festivalDataUrl} title="Festival Lineups: Find Where Your Artist Plays | Synners" description="Search festival lineups across Europe by artist and see every festival they play this season.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">Artists</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Discover which festivals your favorite artists are playing at.
      </p>
    </div>

    <ArtistsPageIsland client:idle dataUrl={festivalDataUrl} />
  </div>
</Layout>
