---
import Layout from "../layouts/Layout.astro";
import { CalendarView } from "../components/CalendarView";
import { festivals } from "@/lib/festival-data";
---

<Layout title="Festival Calendar for Europe: Month by Month | Synners" description="Music festivals in Europe month by month. See what is on in each month, filter by genre and country, and plan the season.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">Festival calendar</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Plan your festival season with our monthly timeline. Only months with festivals are shown.
      </p>
    </div>

    <CalendarView client:idle festivals={festivals} />
  </div>
</Layout>
