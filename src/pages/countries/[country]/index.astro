---
import HubPage from "@/components/HubPage.astro";
import { hubs } from "@/lib/hubs";
import type { Hub } from "@/lib/seo";

export function getStaticPaths() {
  return hubs.countries.map((hub) => ({
    params: { country: hub.path.split("/")[2] },
    props: {
      hub,
      related: [
        ...hubs.combos.filter((c) => c.country === hub.country),
        ...hubs.countries.filter((c) => c !== hub).slice(0, 6),
      ],
    },
  }));
}

const { hub, related } = Astro.props as { hub: Hub; related: Hub[] };
---

<HubPage hub={hub} related={related} crumbs={[{ name: "Home", path: "/" }, { name: "Countries", path: "/countries/" }, { name: hub.country!, path: hub.path }]} />
