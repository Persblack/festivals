---
/**
 * One evergreen page per festival series. It leads with the next edition (or
 * the latest, once a series has no future date) and lists the others below.
 */
import Layout from "@/layouts/Layout.astro";
import { SelectFestivalButton } from "@/components/SelectFestivalButton";
import { hubs, series, todayIso, upcoming } from "@/lib/hubs";
import {
  breadcrumbJsonLd,
  byProminence,
  eventJsonLd,
  festivalPath,
  leadEdition,
  matchesHubGenre,
  seriesSlug,
} from "@/lib/seo";
import { formatDateRange } from "@/lib/dates";
import {
  durationDays,
  factualIntro,
  hubMentions,
  isThinSeries,
  joinWords,
  nearbyFestivals,
  nearestAirports,
  sameDates,
  sameLineupElsewhere,
  venueClause,
} from "@/lib/festival-facts";
import { getGenreCategory } from "@/lib/genre-utils";
import { formatPriceRange, getCountryFlag, getGenreColorHex, getGenreCoverImage, getSizeLabel } from "@/lib/utils";
import type { Festival } from "@/types/festival";

export function getStaticPaths() {
  return [...series.entries()].map(([slug, editions]) => ({ params: { slug }, props: { editions } }));
}

const { editions } = Astro.props as { editions: Festival[] };
const f = leadEdition(editions, todayIso);
const isOver = f.end_date < todayIso;
const others = editions.filter((e) => e !== f).reverse();
const dates = formatDateRange(f.start_date, f.end_date);
const price = formatPriceRange(f.ticket_price_min, f.ticket_price_max, f.currency);
const hasPrice = f.ticket_price_min !== null || f.ticket_price_max !== null;

const countryHub = hubs.countries.find((h) => h.country === f.country_name);
const genreHubs = hubs.genres.filter((h) => f.genres.some((g) => matchesHubGenre({ ...f, genres: [g] }, h.genre!)));
const comboHubs = hubs.combos.filter((h) => h.country === f.country_name && genreHubs.some((g) => g.genre === h.genre));

const categories = new Set(f.genres.map(getGenreCategory));
const mySlug = seriesSlug(f.id);
const similar = upcoming
  .filter((o) => seriesSlug(o.id) !== mySlug && o.country_name === f.country_name && o.genres.some((g) => categories.has(getGenreCategory(g))))
  .sort(byProminence)
  .slice(0, 6);

const thin = isThinSeries(editions);
const days = durationDays(f);
const airports = f.latitude !== null && f.longitude !== null ? nearestAirports(f.latitude, f.longitude) : null;
// The lead edition often has no lineup yet; the last one announced still says who this festival books.
const lineupEdition = f.lineup.length ? f : [...editions].reverse().find((e) => e.lineup.length > 0);
const sharedLineup = lineupEdition ? sameLineupElsewhere(lineupEdition, upcoming) : [];
const overlapping = isOver ? [] : sameDates(f, upcoming);
const nearby = nearbyFestivals(f, upcoming);
const mentions = hubMentions(f, hubs, genreHubs);
const inHubs = !isOver;
const airportText = (a: { airport: { name: string; city: string; iata: string }; km: number }) =>
  `${a.airport.name} (${a.airport.iata})${a.airport.city && !a.airport.name.includes(a.airport.city) ? ` in ${a.airport.city}` : ""}, ${a.km} km away`;

const headliners = f.lineup.slice(0, 3);
// "Else" is the catch-all bucket, not a genre anyone would read as one.
const named = f.genres.filter((g) => g !== "Else");
const genreWords = named.length ? named.join(", ") : "music";
const title = `${f.name} ${f.year}: ${f.lineup.length ? "Dates, Lineup & Tickets" : "Dates & Tickets"} | Synners`;
const description =
  `${f.name} ${f.year} ${isOver ? "took place" : "takes place"} ${dates} in ${f.city}, ${f.country_name}. ` +
  `${genreWords} festival` +
  (headliners.length ? ` with ${headliners.join(", ")}${f.lineup.length > 3 ? " and more" : ""}` : "") +
  (hasPrice ? `. Tickets ${price}.` : ".");

const crumbs = [
  { name: "Home", path: "/" },
  ...(countryHub ? [{ name: countryHub.country!, path: countryHub.path }] : []),
  { name: f.name, path: festivalPath(f.id) },
];
const events = editions.filter((e) => e === f || e.end_date >= todayIso).map(eventJsonLd);

const facts: [string, string][] = [
  ["Dates", dates],
  ["Location", `${f.city}, ${f.country_name}`],
  ...(f.venue ? [["Venue", f.venue] as [string, string]] : []),
  ["Genres", f.genres.join(", ")],
  ["Duration", days === 1 ? "1 day" : `${days} days`],
  ["Size", getSizeLabel(f.size)],
  ["Tickets", price],
  ...(f.lineup.length ? [["Lineup", `${f.lineup.length} artists announced`] as [string, string]] : []),
  ...(airports?.length ? [["Nearest airport", `${airports[0].airport.iata}, ${airports[0].km} km (straight line)`] as [string, string]] : []),
];
const links = [
  f.ticket_link && { href: f.ticket_link, label: `Tickets · ${price}`, primary: true },
  f.website && { href: f.website, label: "Official website" },
  f.instagram && { href: f.instagram, label: "Instagram" },
  f.latitude !== null && f.longitude !== null && { href: `https://www.google.com/maps/search/?api=1&query=${f.latitude},${f.longitude}`, label: "Directions" },
].filter(Boolean) as { href: string; label: string; primary?: boolean }[];
---

<Layout title={title} description={description} jsonLd={[...events, breadcrumbJsonLd(crumbs)]} noindex={thin}>
  <article class="space-y-10">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
      <ol class="flex flex-wrap gap-2">
        {crumbs.map((c, i) => (
          <li>{i > 0 && <span aria-hidden="true" class="mr-2">/</span>}{i === crumbs.length - 1 ? <span aria-current="page" class="text-foreground">{c.name}</span> : <a href={c.path} class="hover:text-white">{c.name}</a>}</li>
        ))}
      </ol>
    </nav>

    <header class="relative overflow-hidden rounded-[28px]">
      <img src={getGenreCoverImage(f.genres)} alt="" width="1200" height="600" class="absolute inset-0 h-full w-full object-cover grayscale contrast-125" />
      <div class="absolute inset-0 bg-primary mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-black/45"></div>
      <div class="relative space-y-4 px-6 py-12 md:px-12 md:py-20">
        <h1 class="text-5xl md:text-8xl text-white">{f.name} {f.year}</h1>
        <p class="text-lg text-white/90">{dates} · {getCountryFlag(f.country_code)} {f.city}, {f.country_name}</p>
        <div class="flex flex-wrap gap-1.5">
          {f.genres.map((g) => <span class="rounded-full px-3 py-1 text-xs font-semibold uppercase text-ink" style={`background:${getGenreColorHex(g)}`}>{g}</span>)}
        </div>
        {isOver && <p class="inline-block rounded-full bg-background px-4 py-1.5 text-sm text-muted-foreground">This edition is over. Next dates not announced yet.</p>}
      </div>
    </header>

    <div class="flex flex-wrap gap-3">
      {links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener" class={l.primary
          ? "rounded-xl bg-primary px-5 py-3 text-sm font-bold uppercase tracking-wider text-white hover:bg-[#B3122A]"
          : "rounded-xl border border-input bg-field px-5 py-3 text-sm font-bold uppercase tracking-wider text-white hover:bg-muted"}>{l.label}</a>
      ))}
      <SelectFestivalButton client:visible festivalId={f.id} variant="full" />
    </div>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="space-y-10">
        <section class="space-y-3">
          <h2 class="break-words text-3xl text-white">About {f.name}</h2>
          <p class="max-w-2xl break-words leading-relaxed text-muted-foreground">
            {f.description?.trim()
              ? `${f.description.trim()} The ${f.year} edition ${isOver ? "ran" : "runs"} ${dates}${venueClause(f)}.`
              : factualIntro(f, editions, isOver)}
          </p>
          {mentions.length > 0 && (
            <p class="max-w-2xl break-words leading-relaxed text-muted-foreground">
              {inHubs ? "On Synners it is one of " : "Synners lists "}
              {mentions.map((m, i) => (
                <>{i > 0 && (i === mentions.length - 1 ? " and " : ", ")}<a href={m.path} class="text-foreground underline decoration-border underline-offset-4 hover:text-white">{m.label}</a></>
              ))}.
            </p>
          )}
        </section>

        {f.lineup.length > 0 && (
          <section class="space-y-3">
            <h2 class="break-words text-3xl text-white">{f.name} {f.year} lineup</h2>
            <ul class="flex flex-wrap gap-2">
              {f.lineup.map((artist) => <li class="rounded-full bg-muted px-3 py-1.5 text-sm text-foreground">{artist}</li>)}
            </ul>
          </section>
        )}

        {sharedLineup.length > 0 && (
          <section class="space-y-3">
            <h2 class="text-3xl text-white">Where these artists also play</h2>
            <p class="max-w-2xl text-sm text-muted-foreground">Upcoming festivals on Synners that list artists from the {lineupEdition!.name} {lineupEdition!.year} lineup.</p>
            <ul class="space-y-3">
              {sharedLineup.map(({ festival: o, artists }) => (
                <li class="rounded-2xl border border-border bg-card p-4">
                  <a href={festivalPath(o.id)} class="break-words font-semibold text-white hover:underline">{o.name} {o.year}</a>
                  <span class="text-muted-foreground"> · {formatDateRange(o.start_date, o.end_date)} · {o.city}, {o.country_name}</span>
                  <p class="mt-1 break-words text-sm text-muted-foreground">
                    {artists.length === 1 ? "Also booked: " : `${artists.length} shared artists: `}
                    {joinWords(artists.slice(0, 8))}{artists.length > 8 ? ` and ${artists.length - 8} more` : ""}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )}

        {(airports || nearby.length > 0) && (
          <section class="space-y-3">
            <h2 class="text-3xl text-white">Getting there</h2>
            {airports && (
              <p class="max-w-2xl break-words leading-relaxed text-muted-foreground">
                {airports.length === 0
                  ? `There is no airport with scheduled flights within 150 km of ${f.city} in a straight line.`
                  : `Nearest ${airports.length === 1 ? "airport" : "airports"} with scheduled flights: ${joinWords(airports.map(airportText))}. Distances are in a straight line from the festival's map position, so the trip by road is longer.`}
              </p>
            )}
            {nearby.length > 0 && (
              <>
                <h3 class="pt-2 text-xl text-white">Upcoming festivals nearby</h3>
                <ul class="space-y-2">
                  {nearby.map(({ festival: o, km }) => (
                    <li class="break-words text-sm text-muted-foreground">
                      <a href={festivalPath(o.id)} class="font-semibold text-white hover:underline">{o.name}</a>
                      {" "}· {formatDateRange(o.start_date, o.end_date)} · {o.city}{km > 0 ? `, ${km} km away` : ", same location"}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}

        {others.length > 0 && (
          <section class="space-y-3">
            <h2 class="text-3xl text-white">Other editions</h2>
            <ul class="space-y-3">
              {others.map((e) => (
                <li class="rounded-2xl border border-border bg-card p-4">
                  <p class="font-semibold text-white">{e.name} {e.year} <span class="font-normal text-muted-foreground">· {formatDateRange(e.start_date, e.end_date)} · {e.city}</span></p>
                  {e.lineup.length > 0 && <p class="mt-1 text-sm text-muted-foreground">{e.lineup.slice(0, 12).join(", ")}{e.lineup.length > 12 ? ` and ${e.lineup.length - 12} more` : ""}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="space-y-8">
        <section class="rounded-2xl border border-border bg-card p-5">
          <h2 class="mb-4 text-2xl text-white">Quick facts</h2>
          <dl class="space-y-3 text-sm">
            {facts.map(([k, v]) => (
              <div>
                <dt class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">{k}</dt>
                <dd class="text-foreground">{v}</dd>
              </div>
            ))}
          </dl>
        </section>

        {(countryHub || genreHubs.length > 0) && (
          <nav aria-label="Browse more" class="space-y-2">
            <h2 class="text-2xl text-white">More like this</h2>
            <ul class="flex flex-wrap gap-2">
              {[...comboHubs, ...(countryHub ? [countryHub] : []), ...genreHubs].map((h) => (
                <li><a href={h.path} class="inline-block rounded-full border border-input bg-field px-4 py-2 text-sm text-foreground hover:bg-muted">{h.heading}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </aside>
    </div>

    {overlapping.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-3xl text-white">On the same dates</h2>
        <p class="max-w-2xl text-sm text-muted-foreground">Other festivals on Synners that overlap with {dates}.</p>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {overlapping.map((o) => (
            <li>
              <a href={festivalPath(o.id)} class="flex h-full flex-col gap-1 rounded-2xl border border-border bg-card p-4 hover:border-input">
                <span class="break-words text-lg font-semibold text-white">{o.name}</span>
                <span class="text-sm text-muted-foreground">{formatDateRange(o.start_date, o.end_date)} · {getCountryFlag(o.country_code)} {o.city}, {o.country_name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {similar.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-3xl text-white">Similar festivals in {f.country_name}</h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {similar.map((o) => (
            <li>
              <a href={festivalPath(o.id)} class="flex h-full flex-col gap-1 rounded-2xl border border-border bg-card p-4 hover:border-input">
                <span class="text-lg font-semibold text-white">{o.name}</span>
                <span class="text-sm text-muted-foreground">{formatDateRange(o.start_date, o.end_date)} · {o.city}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>
