---
import Layout from "../layouts/Layout.astro";
import { festivals } from "@/lib/festival-data";
import { upcomingFestivals } from "@/lib/filters";
import { parseLocalDate, startOfToday } from "@/lib/dates";
import { getGenreColorHex } from "@/lib/utils";
import { FeaturedFestivals } from "../components/FeaturedFestivals";
import { ThisWeekFestivals } from "../components/ThisWeekFestivals";
import { RandomFestivalButton } from "../components/RandomFestivalButton";
import { FestivalAnalytics } from "../components/FestivalAnalytics";

const featuredFestivals = festivals.filter((f) => f.featured);

/**
 * Every headline number on this page describes the rolling window — everything
 * from today forward, whatever year it falls in. Counting the whole file would
 * advertise last season's festivals as if they were still bookable.
 */
const upcoming = upcomingFestivals(festivals);
const upcomingCountries = new Set(upcoming.map((f) => f.country_name));
const upcomingGenres = new Set(upcoming.flatMap((f) => f.genres));
const upcomingArtistCount = new Set(upcoming.flatMap((f) => f.lineup)).size;
// Below 1000 the rounded "0k+" was a lie; say the real number instead.
const uniqueArtists =
  upcomingArtistCount >= 1000
    ? `${(upcomingArtistCount / 1000).toFixed(1)}k+`
    : String(upcomingArtistCount);

const genreTiles = ["EDM", "Techno", "Rock", "Metal", "Else"];

// Festivals this week (Mon-Sun containing today), all in local time.
const today = startOfToday();
const day = today.getDay();
const mondayOffset = day === 0 ? -6 : 1 - day;
const weekStart = new Date(today);
weekStart.setDate(today.getDate() + mondayOffset);
const weekEnd = new Date(weekStart);
weekEnd.setDate(weekStart.getDate() + 6);
weekEnd.setHours(23, 59, 59, 999);

const thisWeekFestivals = festivals.filter((f) => {
  const start = parseLocalDate(f.start_date);
  const end = parseLocalDate(f.end_date);
  return start !== null && end !== null && start <= weekEnd && end >= weekStart;
});
---

<Layout title="Festival Atlas - Your Central European Festival Compass">
  <div class="space-y-20">
    <!-- Hero Section -->
    <section class="text-center py-16 md:py-24 relative overflow-hidden rounded-3xl">
      <!-- Hero background image -->
      <img
        src="/hero-10.webp"
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/60"></div>

      <div class="relative">
        <h1 class="text-5xl md:text-7xl font-extrabold text-foreground mb-6 tracking-tight">
          Festival Atlas
        </h1>
        <p class="text-xl md:text-2xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          Your Central European Festival Compass
        </p>
        <p class="text-lg text-muted-foreground mb-12 max-w-xl mx-auto">
          Discover, explore, and plan your perfect festival experience across Europe's most exciting music destinations.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/map"
            class="px-8 py-4 rounded-xl bg-primary text-primary-foreground font-semibold text-lg shadow-lg shadow-primary/25 hover:scale-105 hover:shadow-xl hover:shadow-primary/30 transition-all duration-300"
          >
            Explore Map
          </a>
          <a
            href="/calendar"
            class="px-8 py-4 rounded-xl bg-secondary text-secondary-foreground font-semibold text-lg shadow-lg shadow-secondary/25 hover:scale-105 hover:shadow-xl hover:shadow-secondary/30 transition-all duration-300"
          >
            View Calendar
          </a>
          <a
            href="/list"
            class="px-8 py-4 rounded-xl border-2 border-border text-foreground font-semibold text-lg hover:bg-muted hover:border-primary/50 transition-all duration-300"
          >
            Browse All
          </a>
        </div>
        <div class="mt-6 flex justify-center">
          <RandomFestivalButton client:load festivals={festivals} />
        </div>
      </div>
    </section>

    <!-- Quick Stats -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="bg-card rounded-2xl p-6 border border-border text-center hover:border-primary/50 transition-colors">
        <div class="text-4xl md:text-5xl font-bold text-primary mb-2">{upcoming.length}</div>
        <div class="text-muted-foreground">Upcoming</div>
      </div>
      <div class="bg-card rounded-2xl p-6 border border-border text-center hover:border-secondary/50 transition-colors">
        <div class="text-4xl md:text-5xl font-bold text-secondary mb-2">{upcomingCountries.size}</div>
        <div class="text-muted-foreground">Countries</div>
      </div>
      <div class="bg-card rounded-2xl p-6 border border-border text-center hover:border-accent/50 transition-colors">
        <div class="text-4xl md:text-5xl font-bold text-accent mb-2">{upcomingGenres.size}</div>
        <div class="text-muted-foreground">Genres</div>
      </div>
      <div class="bg-card rounded-2xl p-6 border border-border text-center hover:border-primary/50 transition-colors">
        <div class="text-4xl md:text-5xl font-bold text-foreground mb-2">{uniqueArtists}</div>
        <div class="text-muted-foreground">Artists</div>
      </div>
    </section>

    <!-- Featured Festivals -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl font-bold text-foreground mb-2">Featured Festivals</h2>
          <p class="text-muted-foreground">The most anticipated events ahead</p>
        </div>
        <a
          href="/list"
          class="text-primary hover:text-primary/80 font-medium transition-colors"
        >
          View all →
        </a>
      </div>

      <FeaturedFestivals client:load festivals={featuredFestivals} />
    </section>

    <!-- This Week -->
    {thisWeekFestivals.length > 0 && (
      <section>
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-3xl font-bold text-foreground mb-2">Festivals This Week</h2>
            <p class="text-muted-foreground">Happening right now or in the coming days</p>
          </div>
        </div>

        <ThisWeekFestivals client:load festivals={thisWeekFestivals} />
      </section>
    )}

    <!-- Genre Overview -->
    <section>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-foreground mb-4">Find Your Sound</h2>
        <p class="text-muted-foreground max-w-lg mx-auto">
          From earth-shaking bass drops to face-melting guitar solos, find the festival that matches your vibe.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        {genreTiles.map((genre) => {
          const count = upcoming.filter((f) => f.genres.includes(genre)).length;
          return (
            <a
              href={`/list?genre=${genre}`}
              class="group bg-card rounded-2xl p-6 border border-border text-center hover:scale-105 transition-all duration-300"
              style={`border-color: ${getGenreColorHex(genre)}40`}
            >
              <div
                class="w-16 h-16 rounded-2xl mx-auto mb-4 flex items-center justify-center transition-transform group-hover:scale-110"
                style={`background-color: ${getGenreColorHex(genre)}20`}
              >
                <span
                  class="text-2xl font-bold"
                  style={`color: ${getGenreColorHex(genre)}`}
                >
                  {count}
                </span>
              </div>
              <h3 class="font-semibold text-foreground">{genre}</h3>
              <p class="text-sm text-muted-foreground">
                {count} festival{count !== 1 ? "s" : ""}
              </p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Analytics -->
    <section>
      <FestivalAnalytics client:visible festivals={festivals} />
    </section>

    <!-- CTA Section -->
    <section class="relative bg-gradient-to-br from-primary/10 via-secondary/10 to-accent/10 rounded-3xl p-12 text-center overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(59,130,246,0.1),transparent_50%)]"></div>
      <div class="relative">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
          Ready to Plan Your Festival Summer?
        </h2>
        <p class="text-lg text-muted-foreground mb-8 max-w-xl mx-auto">
          Use our interactive map and calendar to discover the perfect festivals for your next festival adventure.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/map"
            class="px-8 py-4 rounded-xl bg-foreground text-background font-semibold text-lg hover:scale-105 transition-transform"
          >
            Start Exploring
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
