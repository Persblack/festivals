---
import Layout from "../layouts/Layout.astro";
import { festivals } from "@/lib/festival-data";
import { upcomingFestivals } from "@/lib/filters";
import { parseLocalDate, startOfToday } from "@/lib/dates";
import { GENRE_CATEGORIES, SINS, genreMatchesCategories } from "@/lib/genre-utils";
import { FeaturedFestivals } from "../components/FeaturedFestivals";
import { ThisWeekFestivals } from "../components/ThisWeekFestivals";
import { RandomFestivalButton } from "../components/RandomFestivalButton";
import { FestivalAnalytics } from "../components/FestivalAnalytics";

const featuredFestivals = festivals.filter((f) => f.featured);

/**
 * Every headline number on this page describes the rolling window — everything
 * from today forward, whatever year it falls in. Counting the whole file would
 * advertise last season's festivals as if they were still bookable.
 */
const upcoming = upcomingFestivals(festivals);
const upcomingCountries = new Set(upcoming.map((f) => f.country_name));
const upcomingGenres = new Set(upcoming.flatMap((f) => f.genres));
const upcomingArtistCount = new Set(upcoming.flatMap((f) => f.lineup)).size;
// Below 1000 the rounded "0k+" was a lie; say the real number instead.
const uniqueArtists =
  upcomingArtistCount >= 1000
    ? `${(upcomingArtistCount / 1000).toFixed(1)}k+`
    : String(upcomingArtistCount);

const sinTiles = GENRE_CATEGORIES.map((genre) => ({
  genre,
  ...SINS[genre],
  count: upcoming.filter((f) => genreMatchesCategories(f.genres, [genre])).length,
}));
// The hero card names the busiest named sin (Gluttony is the catch-all), so
// its number is always a real one.
const topSin = sinTiles
  .filter((t) => t.genre !== "Else")
  .reduce((a, b) => (b.count > a.count ? b : a));

// Festivals this week (Mon-Sun containing today), all in local time.
const today = startOfToday();
const day = today.getDay();
const mondayOffset = day === 0 ? -6 : 1 - day;
const weekStart = new Date(today);
weekStart.setDate(today.getDate() + mondayOffset);
const weekEnd = new Date(weekStart);
weekEnd.setDate(weekStart.getDate() + 6);
weekEnd.setHours(23, 59, 59, 999);

const thisWeekFestivals = festivals.filter((f) => {
  const start = parseLocalDate(f.start_date);
  const end = parseLocalDate(f.end_date);
  return start !== null && end !== null && start <= weekEnd && end >= weekStart;
});
---

<Layout title="Synners - Find your place to sin">
  <div class="space-y-20">
    <!-- Hero Section -->
    <section class="flex flex-wrap items-stretch gap-8 pt-4">
      <div class="flex flex-[999_1_520px] flex-col justify-center gap-6">
        <h1 class="text-[clamp(4rem,10vw,8rem)] leading-[0.9] text-white">
          Find your<br />place to <span class="text-primary">sin.</span>
        </h1>
        <p class="max-w-xl text-lg md:text-xl leading-relaxed text-muted-foreground">
          <strong class="font-semibold text-white">{upcoming.length} festivals</strong> and <strong class="font-semibold text-white">{uniqueArtists} artists</strong> across <strong class="font-semibold text-white">{upcomingCountries.size} countries</strong> and <strong class="font-semibold text-white">{upcomingGenres.size} genres</strong>, sorted by the only thing that matters: which sin you came for.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#sins" class="rounded-xl bg-primary px-7 py-4 text-base font-bold uppercase tracking-wider text-white transition-colors hover:bg-[#B3122A]">
            Choose your sin
          </a>
          <a href="/map" class="rounded-xl border border-input bg-field px-7 py-4 text-base font-bold uppercase tracking-wider text-white transition-colors hover:bg-muted">
            Open the map
          </a>
          <RandomFestivalButton client:load festivals={festivals} />
        </div>
      </div>
      <a href={`/list?genre=${topSin.genre}`} class="group relative min-h-[420px] flex-[1_1_340px] overflow-hidden rounded-[28px]">
        <img src="/hero-10.webp" alt="" class="absolute inset-0 h-full w-full object-cover grayscale contrast-125 brightness-75 transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 bg-primary mix-blend-multiply"></div>
        <div class="absolute bottom-5 left-5 rounded-2xl bg-background px-5 py-4">
          <div class="font-display text-4xl text-white">{topSin.sin}</div>
          <div class="mt-1 text-sm text-muted-foreground">{topSin.count} {topSin.genre} festivals ahead</div>
        </div>
      </a>
    </section>

    <!-- Choose your sin -->
    <section id="sins" class="scroll-mt-40">
      <h2 class="mb-6 text-4xl md:text-5xl text-white">Choose your sin</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {sinTiles.map((t) => (
          <a
            href={`/list?genre=${t.genre}`}
            class="group flex flex-col gap-1.5 rounded-[18px] border border-[#333333] bg-card px-5 py-4 transition-colors hover:border-transparent"
          >
            <span class="font-display text-4xl uppercase leading-none text-white">{t.sin}</span>
            <span class="text-sm text-muted-foreground">{t.genre === "Else" ? "Everything else" : t.genre} · {t.count}</span>
            <span class="h-1 w-10 rounded-full transition-all duration-300 group-hover:w-full" style={`background:${t.color}`}></span>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured Festivals -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-4xl md:text-5xl text-white mb-2">Featured</h2>
          <p class="text-muted-foreground">The ones worth confessing to</p>
        </div>
        <a
          href="/list"
          class="font-bold uppercase tracking-wider text-secondary hover:text-white transition-colors"
        >
          View all
        </a>
      </div>

      <FeaturedFestivals client:load festivals={featuredFestivals} />
    </section>

    <!-- This Week -->
    {thisWeekFestivals.length > 0 && (
      <section>
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-4xl md:text-5xl text-white mb-2">This week</h2>
            <p class="text-muted-foreground">Happening right now or in the coming days</p>
          </div>
        </div>

        <ThisWeekFestivals client:load festivals={thisWeekFestivals} />
      </section>
    )}

    <!-- Analytics -->
    <section>
      <FestivalAnalytics client:visible festivals={festivals} />
    </section>

    <!-- CTA Section -->
    <section class="rounded-[28px] bg-primary px-8 py-14 md:px-14">
      <h2 class="max-w-3xl text-5xl md:text-7xl text-white">Plan the summer you'll regret properly.</h2>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/planner" class="rounded-xl bg-background px-7 py-4 text-base font-bold uppercase tracking-wider text-white transition-colors hover:bg-ink">Open the planner</a>
        <a href="/calendar" class="rounded-xl border border-white/80 px-7 py-4 text-base font-bold uppercase tracking-wider text-white transition-colors hover:bg-white/10">See the calendar</a>
      </div>
    </section>
  </div>
</Layout>
