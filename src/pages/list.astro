---
import Layout from "../layouts/Layout.astro";
import { ListViewIsland } from "../components/ListView";
import { festivalDataUrl } from "@/lib/festival-data-file";
---

<Layout preload={festivalDataUrl} title="All Music Festivals in Europe: Filter & Compare | Synners" description="Every music festival in Europe in one list. Filter by genre, country, size, month and artist, sort by date, compare in a table.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">All festivals in Europe</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Browse, filter, and sort all festivals. Switch between grid and table views.
      </p>
    </div>

    <ListViewIsland client:idle dataUrl={festivalDataUrl} />
  </div>
</Layout>
