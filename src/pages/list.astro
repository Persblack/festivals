---
import Layout from "../layouts/Layout.astro";
import { ListView } from "../components/ListView";
import festivalsData from "../data/festivals.json";

const festivals = festivalsData.festivals;
---

<Layout title="All Festivals - Festival Atlas" description="Browse all music festivals with filters, sorting, and grid/table views.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">All Festivals</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Browse, filter, and sort all festivals. Switch between grid and table views.
      </p>
    </div>

    <ListView client:load festivals={festivals} />
  </div>
</Layout>
