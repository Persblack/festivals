---
import Layout from "../layouts/Layout.astro";
import { MapPageIsland } from "../components/MapPage";
import { festivalDataUrl } from "@/lib/festival-data-file";
---

<Layout preload={festivalDataUrl} title="Festival Map of Europe: Every Upcoming Festival | Synners" description="Every upcoming music festival in Europe on one interactive map, with a heat map of the busiest regions. Filter by genre, country and month.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">Festival map of Europe</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Explore all festivals on an interactive map. Toggle heat map view to see festival density across the region.
      </p>
    </div>

    <MapPageIsland client:load dataUrl={festivalDataUrl} />
  </div>
</Layout>
