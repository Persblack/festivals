---
import Layout from "../layouts/Layout.astro";
import { TimelineViewIsland } from "../components/TimelineView";
import { festivalDataUrl } from "@/lib/festival-data-file";
---

<Layout preload={festivalDataUrl} title="Festival Timeline for Europe | Synners" description="Music festivals in Europe on a horizontal timeline, from this week to next summer.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">Festival Timeline</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Visualize all festivals on a horizontal timeline. See overlapping events and plan your season at a glance.
      </p>
    </div>

    <TimelineViewIsland client:load dataUrl={festivalDataUrl} />
  </div>
</Layout>
