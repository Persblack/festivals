---
import Layout from "../layouts/Layout.astro";
import { TimelineView } from "../components/TimelineView";
import festivalsData from "../data/festivals.json";

const festivals = festivalsData.festivals;
---

<Layout title="Timeline View - Festival Atlas" description="View all music festivals on an interactive horizontal timeline.">
  <div class="space-y-6">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-3">Festival Timeline</h1>
      <p class="text-muted-foreground max-w-lg mx-auto">
        Visualize all festivals on a horizontal timeline. See overlapping events and plan your season at a glance.
      </p>
    </div>

    <TimelineView client:load festivals={festivals} />
  </div>
</Layout>
